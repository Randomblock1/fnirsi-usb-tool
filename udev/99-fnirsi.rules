# FNIRSI USB Power Meter udev rules
# Install: sudo cp 99-fnirsi.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger

# FNIRSI FNB48 (data mode)
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="003a", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="003a", MODE="0666", TAG+="uaccess"

# FNIRSI C1 / FNAC28 (data mode)
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="003b", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="003b", MODE="0666", TAG+="uaccess"

# FNIRSI FNB58 DFU mode
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="0038", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="0038", MODE="0666", TAG+="uaccess"

# FNIRSI FNB48S (data mode)
SUBSYSTEM=="usb", ATTR{idVendor}=="2e3c", ATTR{idProduct}=="0049", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2e3c", ATTRS{idProduct}=="0049", MODE="0666", TAG+="uaccess"

# FNIRSI FNB58 (data mode)
SUBSYSTEM=="usb", ATTR{idVendor}=="2e3c", ATTR{idProduct}=="5558", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2e3c", ATTRS{idProduct}=="5558", MODE="0666", TAG+="uaccess"
